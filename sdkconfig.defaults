# Target: run `idf.py set-target esp32s3` once before the first build.

# Flash layout (4 MB is safe on every DevKitC-1 variant)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 240 MHz gives the best Wi-Fi throughput on the S3 (same as the IDF benchmark setup)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Browsers send request headers larger than the 512-byte default (would answer HTTP 431)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
