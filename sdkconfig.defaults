# Target: run `idf.py set-target esp32s3` once before the first build.

# Flash layout (this board has 16 MB; use 4MB instead for other DevKitC-1 variants)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 240 MHz gives the best Wi-Fi throughput on the S3 (same as the IDF benchmark setup)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Browsers send request headers larger than the 512-byte default (would answer HTTP 431)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
